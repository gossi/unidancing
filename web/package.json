  "scripts": {
    "dev": "tinacms dev -c vite",
    "build": "pnpm build:tina && vite build",
    "build:tina": "PROD=true tinacms build",
    "lint": "concurrently -g 'npm:lint:*(!fix)'",
    "lint:fix": "concurrently -g 'npm:lint:*:fix'",
    "lint:css": "stylelint 'app/**/*.css' --allow-empty-input --cache",
    "lint:css:fix": "stylelint 'app/**/*.css' --allow-empty-input --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "start": "vite",
    "start:tina": "tinacms dev",
    "test:prebuild": "tinacms build --local --skip-cloud-checks",
    "test": "vitest run",
    "test:watch": "vitest"
  },
