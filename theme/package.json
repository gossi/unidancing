{
  "name": "@unidancing/theme",
  "version": "0.0.1",
  "type": "module",
  "description": "Moana theme for Hokulea",
  "license": "MIT",
  "keywords": [
    "theemo-theme"
  ],
  "files": [
    "package.json",
    "dist"
  ],
  "theemo": {
    "name": "unidancing",
    "colorSchemes": [
      "light",
      "dark"
    ],
    "file": "dist/unidancing.css",
    "features": [
      {
        "name": "color-scheme",
        "browserFeature": "color-scheme",
        "options": [
          "light",
          "dark"
        ]
      },
      {
        "name": "density",
        "options": [
          "compact",
          "comfortable",
          "spacious"
        ],
        "defaultOption": "comfortable"
      }
    ]
  },
  "scripts": {
    "clean": "rm -rf build/ dist/ tokens/",
    "sync": "theemo sync",
    "build": "pnpm build:sd && pnpm build:theme",
    "build:sd": "style-dictionary build",
    "build:theme": "theemo build",
    "magic": "pnpm sync && pnpm build",
    "clean-magic": "pnpm clean && pnpm magic"
  },
  "devDependencies": {
    "@theemo/build": "1.1.0",
    "@theemo/cli": "1.0.2",
    "@theemo/figma": "1.0.1",
    "@theemo/style-dictionary": "1.0.1",
    "inflection": "^3.0.0",
    "style-dictionary": "5.0.0"
  },
  "engines": {
    "node": ">= 24"
  }
}
